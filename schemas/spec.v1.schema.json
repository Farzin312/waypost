{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Farzin312/waypost/blob/main/schemas/spec.v1.schema.json",
  "title": "Waypost Living Spec v1",
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "1"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "worktree",
            "commit"
          ]
        },
        "sha": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "kind"
      ]
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "workdir": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "requires_bin": {
            "type": "string"
          },
          "local_command": {
            "type": "string"
          },
          "serial": {
            "type": [
              "boolean",
              "null"
            ],
            "default": true
          }
        }
      }
    },
    "pins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "boundaries": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mode": {
              "type": "string",
              "enum": [
                "enforce",
                "ratchet",
                "warn"
              ]
            },
            "baseline": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^/\\\\:\\x00]+(/[^/\\\\:\\x00]+)*$",
              "allOf": [
                {
                  "not": {
                    "pattern": "(^|/)\\.{1,2}(/|$)"
                  }
                },
                {
                  "not": {
                    "pattern": "^\\.([gG][iIİ][tT]|[wW][aA][yY][pP][oO][sS][tT]\\.([yY][aA][mM][lL]|[lL][oO][cC][aA][lL]\\.[yY][aA][mM][lL]|[lL][oO][cC][kKK]))(/|$)"
                  }
                }
              ],
              "description": "Repository-relative baseline file. Defaults to .waypost.baseline.json in ratchet mode."
            },
            "no_cycles": {
              "type": "boolean"
            },
            "enforce_declared_deps": {
              "type": "boolean"
            },
            "ignore_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "target": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "allow_depends_on": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "deny_depends_on": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "public_entrypoints": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "from",
                      "allow_depends_on"
                    ]
                  },
                  {
                    "required": [
                      "from",
                      "deny_depends_on"
                    ]
                  },
                  {
                    "required": [
                      "target",
                      "public_entrypoints"
                    ]
                  }
                ],
                "dependentRequired": {
                  "allow_depends_on": [
                    "from"
                  ],
                  "deny_depends_on": [
                    "from"
                  ],
                  "public_entrypoints": [
                    "target"
                  ]
                }
              }
            }
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "enforce",
            "ratchet",
            "warn"
          ]
        },
        "scan_complete": {
          "type": "boolean"
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "violations": {
          "type": "integer",
          "minimum": 0
        },
        "grandfathered": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_entries": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_occurrences": {
          "type": "integer",
          "minimum": 0
        },
        "baseline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baseline"
          }
        }
      },
      "required": [
        "mode",
        "scan_complete",
        "files_scanned",
        "violations",
        "grandfathered",
        "baseline_entries",
        "baseline_occurrences"
      ],
      "additionalProperties": false
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "history": {
      "$ref": "#/$defs/history"
    },
    "receipt": {
      "type": "object",
      "properties": {
        "head_sha": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PASS",
            "WARN",
            "FAIL"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "command",
              "required",
              "status",
              "exit_code",
              "duration_ms"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "workdir": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "from_base_floor": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "WARN",
                  "SKIP"
                ]
              },
              "exit_code": {
                "type": "integer"
              },
              "duration_ms": {
                "type": "integer"
              },
              "reason": {
                "type": "string"
              },
              "output_excerpt": {
                "type": "string"
              },
              "lane": {
                "type": "string",
                "enum": [
                  "local_changed",
                  "full"
                ]
              },
              "definition_source": {
                "type": "string",
                "enum": [
                  "base",
                  "head",
                  "both"
                ]
              },
              "selection_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "required": [
        "head_sha",
        "outcome",
        "checks"
      ]
    }
  },
  "required": [
    "spec_version",
    "snapshot",
    "policy_digest",
    "components",
    "rules",
    "checks",
    "pins",
    "boundaries",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "declared",
            "manifest",
            "import",
            "test_convention"
          ]
        }
      },
      "required": [
        "value",
        "source"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "declared",
            "manifest"
          ]
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "public_entrypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "depended_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "root",
        "paths",
        "source",
        "entrypoints",
        "public_entrypoints",
        "depends_on",
        "depended_by",
        "tests"
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "invariant",
            "crutch"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "review_after": {
          "type": "string", "format": "date"
        },
        "reason": {
          "type": "string"
        },
        "verified_by": {
          "type": "object",
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "checks"
              ],
              "properties": {
                "checks": {
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "tests"
              ],
              "properties": {
                "tests": {
                  "minItems": 1
                }
              }
            }
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "overrides": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "summary",
        "source"
      ],
      "additionalProperties": false
    },
    "pin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "compatibility_check": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "producer",
            "consumer"
          ]
        },
        "consumer_component": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "npm-package-version",
                "npm-dependency"
              ]
            },
            "manifest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^/\\\\:\\x00]+(/[^/\\\\:\\x00]+)*$",
              "not": {
                "pattern": "(^|/)\\.{1,2}(/|$)|^\\.[gG][iI][tT](/|$)"
              }
            },
            "package": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "manifest"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "properties": {
                "kind": {
                  "const": "npm-dependency"
                }
              },
              "required": [
                "package"
              ]
            },
            {
              "properties": {
                "kind": {
                  "const": "npm-package-version"
                }
              },
              "not": {
                "required": [
                  "package"
                ]
              }
            }
          ]
        },
        "snapshot": {
          "type": "integer",
          "minimum": 0
        },
        "declared_version": {
          "type": "string"
        },
        "observed_version": {
          "type": "string"
        },
        "artifact_identity": {
          "type": "string"
        },
        "integrity": {
          "type": "string"
        },
        "release_line": {
          "type": "string"
        },
        "producer_version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "aligned",
            "unknown",
            "drift",
            "behind"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "producer",
        "artifact",
        "consumer",
        "status",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "cycle_members": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cycle_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "cycle_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "kind",
        "rule_id",
        "from",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "properties": {
        "parent": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "complete": {
          "type": "boolean"
        },
        "ownership": {
          "type": "string",
          "enum": [
            "resolved",
            "unknown",
            "inferred"
          ]
        },
        "omitted_changes": { "type": "integer", "minimum": 0 },
        "omitted_unmapped_paths": { "type": "integer", "minimum": 0 },
        "omitted_policy_changes": { "type": "integer", "minimum": 0 },
        "baseline_count": { "type": "integer", "minimum": 0 },
        "omitted_baseline_occurrences": { "type": "integer", "minimum": 0 },
        "cycle_edge_count": { "type": "integer", "minimum": 0 },
        "omitted_cycle_edges": { "type": "integer", "minimum": 0 },
        "component_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "old_path": {
                "type": "string"
              },
              "old_owners": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "new_owners": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "status",
              "path"
            ],
            "additionalProperties": false
          }
        },
        "impact": {
          "type": "object",
          "properties": {
            "changed_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "direct_components": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "transitive_dependents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "triggered_pins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unmapped_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "trust_path",
                  "policy_floor",
                  "contract_pin"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 12
              },
              "omitted": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "code",
              "items"
            ],
            "additionalProperties": false
          }
        },
        "policy_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "rule",
                  "component",
                  "check",
                  "pin",
                  "boundary_policy",
                  "boundary_rule"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "change": { "enum": ["added", "removed", "modified"] },
              "fields": { "type": "array", "items": { "type": "string" } },
              "before": {
                "type": "object"
              },
              "after": {
                "type": "object"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "baseline_occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entry": {
                "$ref": "#/$defs/baseline"
              },
              "before": {
                "type": "integer",
                "minimum": 0
              },
              "after": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "entry",
              "before",
              "after"
            ],
            "additionalProperties": false
          }
        },
        "cycle_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "edge": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              },
              "change": {
                "type": "string",
                "enum": [
                  "added",
                  "removed"
                ]
              }
            },
            "required": [
              "rule",
              "edge",
              "change"
            ],
            "additionalProperties": false
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "complete",
        "ownership",
        "impact"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "properties": {
        "history_version": {
          "const": "1"
        },
        "ref_sha": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "traversal": {
          "type": "string",
          "enum": [
            "first-parent",
            "all-parents"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sha": {
                "type": "string",
                "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "date": {
                "type": "string",
                "format": "date-time"
              },
              "subject": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
